# SubTrans Studio: API keys are read ONLY from this file (copy to backend/.env).
# Leave a key empty if you do not use that provider.

# Stage 2 (and optionally Stages 1 & 3 in "All DeepSeek" mode)
DEEPSEEK_API_KEY=

# Stage 3 critic (Claude Sonnet 5.5)
ANTHROPIC_API_KEY=

# Stage 1 Bible / Stage 3 critic (Gemini 4 Argon via the OpenAI-compatible endpoint)
GEMINI_API_KEY=

# "All OpenRouter" mode
OPENROUTER_API_KEY=

# Optional overrides
# SUBTRANS_DB_PATH=./data/subtrans.db
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# SUBTRANS_CORS_ORIGINS=http://localhost:5173
